# ========================================================
# HostelEase - Smart Hostel Management System Configuration
# Copy this file to .env or configure in system environment
# ========================================================

# Supabase PostgreSQL Database Configuration
# Obtain these from your Supabase Project Dashboard -> Project Settings -> Database
# For standard networks without IPv6, use the Connection Pooler endpoint (aws-0-[region].pooler.supabase.com:5432)
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=hostelease_app.[YOUR_PROJECT_REF]
SUPABASE_DB_PASSWORD=[YOUR_SUPABASE_DB_PASSWORD]
SUPABASE_DB_SSLMODE=require

# Local/Fallback Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hostelease_db
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_SSLMODE=prefer
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Application Settings
APP_NAME=HostelEase
APP_BASE_URL=http://localhost:8080/HostelEase
SESSION_TIMEOUT_MINUTES=60

# Email (SMTP) Configuration (Jakarta Mail)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@hostelease.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=HostelEase Support <notifications@hostelease.com>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# SMS Provider Configuration (Twilio or Mock)
# Options: MOCK, TWILIO
SMS_PROVIDER=MOCK
SMS_ACCOUNT_ID=AC_mock_twilio_account_sid
SMS_AUTH_TOKEN=mock_twilio_auth_token
SMS_SENDER_ID=+15551234567
SMS_API_BASE_URL=https://api.twilio.com/2010-04-01

# System Mode: DEVELOPMENT, PRODUCTION
APP_ENV=PRODUCTION
